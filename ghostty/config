quit-after-last-window-closed = true
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title
quick-terminal-screen = mouse
copy-on-select = false
window-colorspace = display-p3
window-theme = system
window-padding-x = 3
window-padding-y = 3
window-padding-balance = false
window-padding-color = extend
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-size = 12
font-family = JetbrainsMono Nerd Font
font-feature = -calt, -liga, -dlig
cursor-invert-fg-bg = true
cursor-opacity = 0.5
mouse-shift-capture = true
focus-follows-mouse = false
macos-option-as-alt = true
macos-titlebar-style = tabs
auto-update = download
auto-update-channel = stable
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right
keybind = cmd+alt+p=goto_split:previous
keybind = cmd+alt+n=goto_split:next
keybind = cmd+r=prompt_tab_title
keybind = cmd+g=text:\x07

config-file = ?local
